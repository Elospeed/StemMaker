<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="StemMaker"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
      <Icon Value="0"/>
    </General>
    <VersionInfo>
      <UseVersionInfo Value="True"/>
      <MajorVersionNr Value="1"/>
      <MinorVersionNr Value="6"/>
      <StringTable CompanyName="Elospeed" FileDescription="Elospeed StemMaker - Traktor-Stem-Dateien aus MP3" LegalCopyright="(c) 2026 Elospeed" ProductName="Elospeed StemMaker" ProductVersion="1.6"/>
    </VersionInfo>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="StemMaker.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="umain.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="frmMain"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="uMain"/>
      </Unit>
      <Unit>
        <Filename Value="ustemjob.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uStemJob"/>
      </Unit>
      <Unit>
        <Filename Value="uinit.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uInit"/>
      </Unit>
      <Unit>
        <Filename Value="udownload.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uDownload"/>
      </Unit>
      <Unit>
        <Filename Value="ustemmp4.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uStemMP4"/>
      </Unit>
      <Unit>
        <Filename Value="ulog.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uLog"/>
      </Unit>
      <Unit>
        <Filename Value="udonate.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uDonate"/>
      </Unit>
      <Unit>
        <Filename Value="uinfo.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uInfo"/>
      </Unit>
      <Unit>
        <Filename Value="ulogui.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uLogUI"/>
      </Unit>
      <Unit>
        <Filename Value="upower.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPower"/>
      </Unit>
      <Unit>
        <Filename Value="ulang.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uLang"/>
      </Unit>
      <Unit>
        <Filename Value="ulangui.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uLangUI"/>
      </Unit>
      <Unit>
        <Filename Value="uqueue.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uQueue"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="../bin/StemMaker"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <Optimizations>
        <OptimizationLevel Value="2"/>
      </Optimizations>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <GenerateDebugInfo Value="True"/>
        <DebugInfoType Value="dsDwarf2Set"/>
        <UseLineInfoUnit Value="True"/>
        <StripSymbols Value="False"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
