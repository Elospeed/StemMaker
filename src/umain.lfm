    object lblFormat: TLabel
      Left = 8
      Height = 15
      Top = 76
      Width = 100
      Caption = 'Audio-Format:'
      ParentColor = False
    end
    object cbFormat: TComboBox
      Left = 120
      Height = 25
      Top = 72
      Width = 330
      ItemHeight = 15
      Items.Strings = (
        'AAC automatisch (wie die Quelle, max. 320 kbit/s)'
        'AAC 256 kbit/s (NI-Standard)'
        'AAC 320 kbit/s'
        'ALAC verlustfrei (gro'#223'e Dateien)'
      )
      ParentShowHint = False
      ShowHint = True
      Hint = 'Automatisch: Die Stem-Datei bekommt die Bitrate der Quelle (z.B. MP3 256 -> AAC 256).'#13#10'Gr'#246'sser bringt nichts - besser als die Quelle wird es nie.'#13#10'Sehr niedrige Quellen (unter 192) bekommen 192, damit beim Neu-Kodieren nichts zus'#228'tzlich verloren geht.'
      Style = csDropDownList
      TabOrder = 4
    end
    object btnSettings: TBitBtn
      Left = 120
      Height = 28
      Top = 102
      Width = 230
      Caption = 'Weitere Einstellungen...'
      Hint = 'Stem-Namen und Farben, Teile/Kerne, '#220'berschreiben, Unterordner, Standby, Sprache, Updates, Werkzeuge'
      OnClick = btnSettingsClick
      Spacing = 6
      TabOrder = 16
    end
    object lblTools: TLabel
      Left = 8
      Height = 15
      Top = 134
      Width = 840
      Caption = 'Tools: ...'
      ParentColor = False
      ParentFont = False
    end
    object chkShutdown: TCheckBox
      Left = 470
      Height = 19
      Top = 107
      Width = 380
      Caption = 'PC nach Abschluss herunterfahren'
      ParentShowHint = False
      ShowHint = True
      Hint = 'Wenn alle Dateien fertig sind, wird der PC nach 60 Sekunden heruntergefahren (abbrechbar).'
      TabOrder = 13
    end
    object chkNormalize: TCheckBox
      Left = 470
      Height = 19
      Top = 43
      Width = 330
      Caption = 'Lautst'#228'rke angleichen (Club-Pegel)'
      ParentShowHint = False
      ShowHint = True
      Hint = 'Leise Dateien werden angehoben, bis die lauteste Stelle knapp unter 0 dB liegt (ca. -1 dB).'#13#10'Alle 5 Spuren bekommen denselben Wert, ohne Limiter - die Dynamik bleibt wie im Original.'#13#10'Laute Club-Tracks '#228'ndern sich kaum. Vorteil in Traktor: gr'#246#223'ere, besser lesbare Wellenformen.'
      TabOrder = 14
    end
    object chkBassFix: TCheckBox
      Left = 470
      Height = 19
      Top = 75
      Width = 380
      Caption = 'Bass-Fix: Tiefbass von Other nach Bass'
      ParentShowHint = False
      ShowHint = True
      Hint = 'Der Tiefbass unter 80 Hz, den die Trennung im Stem "Other" l'#228'sst, wird in den Bass-Stem verschoben.'#13#10'Der Bass-Stem wird dadurch voller (wie bei Traktors eigenen Stems), alle Stems zusammen klingen unver'#228'ndert.'
      TabOrder = 15
    end
  end
